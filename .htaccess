# Godoy's Wolves LLC — Hostinger Static Export .htaccess
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and non-www canonical
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.godoyswolves\.com$ [NC]
  RewriteRule ^(.*)$ https://godoyswolves.com/$1 [R=301,L]

  # 2. Legacy Hostinger Website Builder & Google Ads Sitelink 301 Redirects
  RewriteRule ^residential/landscaping/?$ /residential/ [R=301,L,NE]
  RewriteRule ^junk-removal/dfw/?$ /junk-removal/ [R=301,L,NE]
  RewriteRule ^new-homes/landscaping/?$ /new-homes/ [R=301,L,NE]
  RewriteRule ^commercial/landscaping/?$ /commercial/ [R=301,L,NE]
  RewriteRule ^landscaping/hardscape/?$ /residential/ [R=301,L,NE]
  RewriteRule ^irrigation/dfw/?$ /sprinkler-repair/ [R=301,L,NE]
  RewriteRule ^contact(-us)?/?$ /#quote [R=301,L,NE]
  RewriteRule ^about(-us)?/?$ /#about [R=301,L,NE]
  RewriteRule ^(book|booking|schedule|appointments)/?$ /#quote [R=301,L,NE]
  RewriteRule ^thank-you/?$ / [R=301,L,NE]
  RewriteRule ^tree-service-denison/?$ /tree-service-sherman/ [R=301,L,NE]
  RewriteRule ^horse-rentals/?$ /ranch/ [R=301,L,NE]
  RewriteRule ^tree-service-1/?$ /tree-service/ [R=301,L,NE]
  RewriteRule ^landscape/?$ /residential/ [R=301,L,NE]
  RewriteRule ^skid-loader/?$ /concrete-removal/ [R=301,L,NE]
  RewriteRule ^pressure-washing/?$ /commercial/ [R=301,L,NE]
</IfModule>

# 3. Security & Crawl Headers
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self';"

  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# 4. Correct MIME types for AI discovery & modern image assets
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

# 5. Performance caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
