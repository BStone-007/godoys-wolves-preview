# GENERATED by scripts/gen-htaccess.mjs — do not hand-edit.
# Mirrors the redirect table from the old Manus server/index.ts.

Options -MultiViews
RewriteEngine On

# --- Canonical host: www -> non-www, ONE hop (no chains) ---------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --- Dead legacy sitemap: must 404, not fall through to the SPA/404 page -----
# Search Console flagged this when it used to serve the app shell.
RewriteRule ^sitemap\.website\.xml$ - [R=404,L]

# --- Explicit URL-continuity 301s -------------------------------------------
RedirectMatch 301 ^/residential/landscaping/?$ /residential/
RedirectMatch 301 ^/junk-removal/dfw/?$ /junk-removal/
RedirectMatch 301 ^/new-homes/landscaping/?$ /new-homes/
RedirectMatch 301 ^/commercial/landscaping/?$ /commercial/
RedirectMatch 301 ^/landscaping/hardscape/?$ /residential/
RedirectMatch 301 ^/irrigation/dfw/?$ /commercial/

# --- Two-segment safety net --------------------------------------------------
# /commercial/anything-unknown -> /commercial/  (only when no real file exists)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^residential/[^/]+/?$ /residential/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^commercial/[^/]+/?$ /commercial/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^junk-removal/[^/]+/?$ /junk-removal/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^new-homes/[^/]+/?$ /new-homes/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tree-service/[^/]+/?$ /tree-service/ [R=301,L]

# --- Correct content type for the sitemap ------------------------------------
<Files "sitemap.xml">
  ForceType application/xml
</Files>

# --- Trailing-slash directory index (matches trailingSlash: true) ------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

ErrorDocument 404 /404.html

# --- Caching: hashed build assets immutable, HTML always revalidated ---------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
